      <column caption="Churn rate" datatype="real" name="[Calculation_0028395474564237]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="SUM([churners]) / SUM([customers])" />
      </column>
      <column caption="Overall churn rate" datatype="real" name="[Calculation_2236860066113983]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="SUM(IF [dimension] = &quot;Geography&quot; THEN [churners] END) / SUM(IF [dimension] = &quot;Geography&quot; THEN [customers] END)" />
      </column>
      <column caption="Balance at risk share" datatype="real" name="[Calculation_9176102226325456]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="SUM(IF [dimension] = &quot;Geography&quot; THEN [balance_at_risk] END) / SUM(IF [dimension] = &quot;Geography&quot; THEN [segment_balance] END)" />
      </column>
    </datasource>
