          <members>
            <member value="&quot;best&quot;" />
            <member value="&quot;base&quot;" />
            <member value="&quot;worst&quot;" />
          </members>
        </column>
        <column caption="Capacity" datatype="string" name="[Capacity]" param-domain-type="list" role="measure" type="nominal" value="&quot;10%&quot;">
          <calculation class="tableau" formula="&quot;10%&quot;" />
          <members>
            <member value="&quot;10%&quot;" />
            <member value="&quot;15%&quot;" />
            <member value="&quot;Unconstrained&quot;" />
          </members>
        </column>
      </datasource-dependencies>
      <zones>
        <zone h="100000" id="1" type-v2="layout-basic" w="100000" x="0" y="0">
