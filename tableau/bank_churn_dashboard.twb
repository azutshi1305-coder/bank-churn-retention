      <aliases enabled="yes" />
      <column caption="Cost scenario" datatype="string" name="[Cost scenario]" param-domain-type="list" role="measure" type="nominal" value="&quot;base&quot;">
        <calculation class="tableau" formula="&quot;base&quot;" />
        <members>
          <member value="&quot;best&quot;" />
          <member value="&quot;base&quot;" />
          <member value="&quot;worst&quot;" />
